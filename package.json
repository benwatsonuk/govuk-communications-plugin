{
  "name": "@benwatsonuk/govuk-communications-plugin",
  "author": "BenWatsonUK",
  "description": "A plugin to integrate simulations of communication patterns such as email or SMS notifications into GOV.UK prototypes. Including the ability to simulate communications and convey the passing of time between interactions.",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/benwatsonuk/govuk-communications-plugin",
  "bugs": {
    "url": "https://github.com/benwatsonuk/govuk-communications-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benwatsonuk/govuk-communications-plugin.git"
  },
  "scripts": {
    "test": "mocha --require ts-node/register",
    "clean": "rimraf dist",
    "dev": "tailwindcss -i ./src/assets/stylesheets/tailwind.css -o ./dist/assets/stylesheets/tailwind.css --watch",
    "build:js": "esbuild src/assets/javascripts/all.js --bundle --outfile=dist/assets/javascripts/all.js",
    "build:tailwind": "tailwindcss -i ./src/assets/stylesheets/tailwind.css -o ./dist/assets/stylesheets/tailwind.css --minify",
    "build": "npm run clean && tsc && cpx \"src/{assets,views}/**/*\" dist && npm run build:tailwind && npm run build:js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.8",
    "chai": "^4.3.7",
    "cpx": "^1.2.1",
    "esbuild": "^0.28.2",
    "mocha": "^11.7.5",
    "nyc": "^14.1.1",
    "rimraf": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
