{% macro emailHeader(params) %}
	<div class="email--header">
		<dl>
			<div>
				<dt>From:</dt>
				<dd>{{ emailSenderName }}
					&lt;<a href="#">{{ emailSenderEmail }}</a>&gt;</dd>
			</div>
			<div>
				<dt>Subject:</dt>
				<dd>
					<strong>{{ emailSubject }}</strong>
				</dd>
			</div>
			<div>
				<dt>Date:</dt>
				<dd>
					<span data-date></span>
				</dd>
			</div>
			<div>
				<dt>Reply-To:</dt>
				<dd>
					<a href="#">{{ emailReplyTo }}</a>
				</dd>
			</div>
		</dl>
	</div>
	<script>
		const dateElements = document.querySelectorAll( '[data-date]' );
const now = new Date();
const options = {





year: 'numeric',
month: 'long',
day: 'numeric',
hour: '2-digit',
minute: '2-digit',
second: '2-digit',
timeZoneName: 'short'





};
const formattedDate = now.toLocaleDateString( 'en-GB', options );

dateElements.forEach( element => {





element.textContent = formattedDate;





} );
	</script>

{% endmacro %}}
